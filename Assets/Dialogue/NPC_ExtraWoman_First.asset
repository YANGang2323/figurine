    hasChoice: 0
    choices: []
  - speakerName: "\uC5EC\uC790"
    text: "\uC598, \uC774\uC0C1\uD558\uAE34! \uB098\uB3C4 \uBB3C\uB860 \uBCF4\uACE0
      \uC2F6\uC9C0\uB9CC\u2026"
    hideBackground: 0
