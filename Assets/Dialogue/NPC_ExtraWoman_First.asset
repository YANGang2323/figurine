    hasChoice: 0
    choices: []
  - speakerName: 
    text: "\uB09C \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uC9C0 \uC54A\uC544\uC11C \uB298
      \uC774 \uADC0\uCC2E\uC740 \uAE30\uACC4\uB97C \uB2EC\uACE0 \uC0B4\uC544\uC57C\uD588\uB2E4.
      YES."
