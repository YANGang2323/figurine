    soundEffect: {fileID: 0}
    soundVolume: 1
    hasChoice: 0
    choices: []
  - speakerName: "\uC5EC\uC790"
    text: "\uB610 \uC7A5\uCE58\uB97C \uB044\uACE0 \uC788\uC5C8\uAD6C\uB098?"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 1
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 0
    dialogueFont: {fileID: 0}
    useCustomSpeakerFont: 0
    speakerFont: {fileID: 0}
    useCustomDialogueSize: 0
    dialogueFontSize: 0
    useCustomSpeakerSize: 0
    speakerFontSize: 0
    useCustomDialogueColor: 0
    dialogueColor: {r: 1, g: 1, b: 1, a: 1}
    useCustomSpeakerColor: 0
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    soundEffect: {fileID: 0}
    soundVolume: 1
    hasChoice: 0
    choices: []
  - speakerName: "\uC5EC\uC790"
    text: "\uC0C8\uB85C \uC81C\uC791\uB41C \uD3EC\uC2A4\uD130 \uB9D0\uC774\uC57C.
      \uBC15\uC0AC\uB2D8\uC758 \uADF8 \uC778\uC790\uD55C \uC5BC\uAD74\uC744 \uBC18\uC758
      \uBC18\uB3C4 \uBABB \uB2F4\uC544\uB0C8\uC9C0 \uBB50\uB2C8."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 0
    dialogueFont: {fileID: 0}
    useCustomSpeakerFont: 0
    speakerFont: {fileID: 0}
    useCustomDialogueSize: 0
    dialogueFontSize: 0
    useCustomSpeakerSize: 0
    speakerFontSize: 0
    useCustomDialogueColor: 0
    dialogueColor: {r: 1, g: 1, b: 1, a: 1}
    useCustomSpeakerColor: 0
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    soundEffect: {fileID: 0}
    soundVolume: 1
    hasChoice: 0
    choices: []
  - speakerName: "\uC5EC\uC790"
    text: "\uC8FC\uC5F0 \uCE90\uC2A4\uD305\uB3C4 \uBD24\uC5B4? \uC6B0\uB9AC \uBCA0\uC778
      \uAC00 \uC0AC\uB78C\uC774 \uC774\uB984\uC744 \uC62C\uB838\uC5B4!"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 0
    dialogueFont: {fileID: 0}
    useCustomSpeakerFont: 0
    speakerFont: {fileID: 0}
    useCustomDialogueSize: 0
    dialogueFontSize: 0
    useCustomSpeakerSize: 0
    speakerFontSize: 0
    useCustomDialogueColor: 0
    dialogueColor: {r: 1, g: 1, b: 1, a: 1}
    useCustomSpeakerColor: 0
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    soundEffect: {fileID: 0}
    soundVolume: 1
    hasChoice: 0
    choices: []
  - speakerName: "\uC5EC\uC790"
    text: "\uBC15\uC0AC\uB2D8 \uC5ED\uC740 \uADF8\uB300\uB85C\uB354\uB77C. \uC8FD\uAE30
      \uC804\uC5D0 \uADF8 \uC5ED\uD560\uC744 \uBB34\uB300\uC5D0\uC11C \uC9C1\uC811
      \uBCF4\uACE0 \uC2F6\uC740\uB370."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 0
    dialogueFont: {fileID: 0}
    useCustomSpeakerFont: 0
    speakerFont: {fileID: 0}
    useCustomDialogueSize: 0
    dialogueFontSize: 0
    useCustomSpeakerSize: 0
    speakerFontSize: 0
    useCustomDialogueColor: 0
    dialogueColor: {r: 1, g: 1, b: 1, a: 1}
    useCustomSpeakerColor: 0
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    soundEffect: {fileID: 0}
    soundVolume: 1
    hasChoice: 0
    choices: []
  - speakerName: "\uC5EC\uC790"
    text: "\uC5D8\uB9AC\uC5B4\uC2A4\uB294 \uCE90\uC2A4\uD305\uC5D0 \uAE50\uAE50\uD558\uAE30\uB85C
      \uC720\uBA85\uD558\uC796\uC544. \uADF8 \uC5EC\uC790\uC758 \uB208\uC5D0 \uCC28\uB294
      \uBC30\uC6B0\uAC00 \uC5B8\uC81C\uCBE4 \uB4F1\uC7A5\uD560\uAE4C?"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 0
