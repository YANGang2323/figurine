  - speakerName: "\uBE48\uC13C\uD2B8 \uBCA0\uC778"
    text: "\uADF8\uB798\uB3C4 \uBC15\uC0AC\uB2D8\uC744 \uC704\uD55C \uD5CC\uC815
      \uACF5\uC5F0\uC778\uB370, \uADF8\uBD84\uC758 \uC5ED\uC774 \uBE44\uC5B4\uC788\uB294
      \uAC74 \uC774\uC0C1\uD558\uC9C0 \uC54A\uB098\uC694?"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 21300000, guid: 40bd066d7b2b57e4483a9d8476223c31, type: 3}
