%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d8d317eef674082489f00248ae6df60c, type: 3}
  m_Name: NPC_ExtraWoman_First
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: "\uC5D1\uC2A4\uD2B8\uB77C1 first"
  playOnlyOnce: 1
  lines:
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C1"
    text: "\u3161...\u3161\u3161...\u3161..."
    portrait: {fileID: 0}
  - speakerName: ' '
    text: "\uADF8\uC758 \uC785\uC740 \uC6C0\uC9C1\uC774\uB098, \uB2F9\uC2E0\uC5D0\uAC8C\uB294
      \uC544\uBB34 \uC18C\uB9AC\uB3C4 \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4. "
    portrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "(\uC544, \uB9DE\uB2E4. \uC9C0\uAE08\uC740 \uB044\uACE0 \uC788\uC5C8\uB098...)"
    portrait: {fileID: 0}
  - speakerName: 
    text: "\uB2F9\uC2E0\uC740 \uC190\uC744 \uC62C\uB824 \uADD3\uAC00\uC758 \uAF43\uD78C
      \uD55C \uAE30\uACC4\uC758 \uBC84\uD2BC\uC744 \uB20C\uB800\uB2E4."
    portrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C1"
    text: "\u3161 \uD574\uC11C, ...\uC544. \uD639\uC2DC \uC798 \uC548\uB4E4\uB9AC\uC168\uB098\uC694?"
    portrait: {fileID: 0}
  - speakerName: 
    text: "\uC5EC\uC131\uC740 \uB2F9\uC2E0\uC758 \uADC0 \uCABD\uC5D0 \uC2DC\uC120\uC744
      \uB450\uB2E4\uAC00, \uBBF8\uC548\uD55C\uB4EF\uD55C \uD45C\uC815\uC744 \uC9C0\uC5C8\uB2E4."
    portrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC544\uB1E8. \uC81C \uC2E4\uC218\uC778\uAC78\uC694. \uC624\uB79C\uB9CC\uC5D0
      \uBD59\uAC8C\uB418\uB2C8 \uC88B\uB124\uC694. "
    portrait: {fileID: 0}
  - speakerName: 
    text: "\uB2F9\uC2E0\uC740 \uC775\uC219\uD558\uAC8C \uC774\uC57C\uAE30\uB97C \uC774\uC5B4\uAC04\uB2E4. "
    portrait: {fileID: 0}
  - speakerName: 
    text: "\uC5EC\uC131\uC740 \uB2F9\uC2E0\uC5D0\uAC8C \uC788\uC5B4 \uC775\uC219\uD55C
      \uC0AC\uB78C\uC774\uC5C8\uB2E4. \uAC19\uC740 '\uBCA0\uC778'\uC774\uB77C\uB294
      \uC131\uC744 \uC0AC\uC6A9\uD558\uB294, \uBA3C \uCE5C\uCC99. "
    portrait: {fileID: 0}
  - speakerName: 
    text: "\uC624\uB298 \uAC19\uC740 \uD589\uC0AC \uB54C\uB098 \uBCFC \uC218 \uC788\uB294
      \uC0AC\uB78C\uC774\uC5C8\uB2E4. "
    portrait: {fileID: 0}
  - speakerName: 
    text: "\uB2F9\uC2E0\uC740 \uADF8\uB140\uC640 \uAC00\uBCBC\uC6B4 \uC774\uC57C\uAE30\uB97C
      \uB9C8\uCE5C \uB4A4, \uB2E4\uC2DC \uADD3\uAC00\uB97C \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4."
    portrait: {fileID: 0}
  - speakerName: 
    text: "\uD655\uC2E4\uD558\uAC8C \uB290\uAEF4\uC9C0\uB294 \uAE30\uACC4\uC758 \uAC10\uAC01.
      \uBCF4\uCCAD\uAE30\uC640 \uBE44\uC2B7\uD55C, \uD5C8\uB098 \uB354 \uBC1C\uC804\uB41C
      \uAE30\uACC4\uB77C \uD588\uB358\uAC00. "
    portrait: {fileID: 0}
  - speakerName: ' '
    text: "\uC120\uCC99\uC801\uC73C\uB85C \uADC0\uAC00 \uC57D\uD558\uAC8C \uD0DC\uC5B4\uB098
      \uC18C\uB9AC\uB97C \uB4E3\uB294 \uAC83\uC774 \uB0A8\uB4E4\uBCF4\uB2E4 \uD798\uB4E4\uC5C8\uB358
      \uB2F9\uC2E0\uC5D0\uAC8C\uB294 \uD56D\uC0C1 \uD544\uC694\uD55C \uAC83\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "....\uADF8\uB7AC\uB098?"
    portrait: {fileID: 0}
  - speakerName: ' '
    text: "\uADF8\uB7AC\uB2E4. \uB2F9\uC2E0\uC740 \uC5B4\uB5A0\uD55C \uC758\uAD6C\uC2EC\uB3C4
      \uC5C6\uC774 \uAE30\uACC4\uC5D0\uC11C \uC190\uC744 \uB0B4\uB838\uB2E4. "
    portrait: {fileID: 0}
