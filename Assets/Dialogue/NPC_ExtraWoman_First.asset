  - speakerName: 
    text: "\uC74C\uC131 \uC785\uB825 \uC7A5\uCE58 \uAC00\uB3D9. \uC9C0\uAE08\uBD80\uD130
      \uC678\uBD80 \uC18C\uB9AC\uAC00 \uAE30\uACC4\uC74C\uC73C\uB85C \uBCC0\uD658\uB418\uC5B4
      \uCD9C\uB825\uB429\uB2C8\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 1
