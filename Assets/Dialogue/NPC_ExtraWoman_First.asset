  - speakerName: "\uC5EC\uC790"
    text: "\uADF8\uBD84\uC758 \uBE48 \uC790\uB9AC\uAC00 \uB290\uAEF4\uC9C0\uC9C0
      \uC54A\uC744 \uB9CC\uD07C \uC8FC\uC778\uACF5\uB4E4\uC740 \uBCF4\uC774\uC9C0
      \uC54A\uB294 \uADF8\uC5D0\uAC8C \uB3C4\uC6C0\uC744 \uBC1B\uC796\uC544."
    hideBackground: 0
