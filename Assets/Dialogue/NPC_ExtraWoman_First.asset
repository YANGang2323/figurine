    hasChoice: 0
    choices: []
  - speakerName: 
    text: "\uCCAD\uAC01 \uB3D9\uAE30\uD654 \uD504\uB85C\uC138\uC2A4 \uC2DC\uC791\u2026"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 1
