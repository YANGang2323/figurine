  - speakerName: "\uBE48\uC13C\uD2B8 \uBCA0\uC778"
    text: "\uC7A0\uAE50\uB9CC\uC694! \uC81C \uB9D0 \uC880 \uB4E4\uC5B4\uBCF4\uC138\uC694!
      \uC800 \uAC00\uBC29\uC740 \uC81C\uAC00 \uB4E4\uACE0 \uB4E4\uC5B4\uC628 \uAC74
      \uB9DE\uC9C0\uB9CC, \uC548\uC5D0 \uD3ED\uD0C4\uC774 \uB4E4\uC5B4\uC788\uB294
      \uC904\uC740 \uC815\uB9D0 \uBAB0\uB790\uC2B5\uB2C8\uB2E4!"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 21300000, guid: 83f481c23212f1b47b3ffe6a7b41f9d2, type: 3}
    hideRightPortrait: 0
