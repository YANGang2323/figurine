  - speakerName: 
    text: "\uB098\uB294 \uBCC0\uBA85\uD558\uB4EF \uAC00\uBC29\uC774 \uD3ED\uBC1C\uD55C
      \uC790\uB9AC\uB97C \uAC00\uB9AC\uD0A4\uBA70 \uB4B7\uAC78\uC74C\uC9C8 \uCCE4\uB2E4."
    hideBackground: 0
