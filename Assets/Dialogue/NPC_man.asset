%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d8d317eef674082489f00248ae6df60c, type: 3}
  m_Name: NPC_man
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: NPC_man
  playOnlyOnce: 1
  lines:
  - speakerName: 
    text: "\uC5B4\uCA50\uC9C0 \uC218\uD2B8\uD54F\uC774 \uB05D\uB0B4\uC8FC\uB294 \uB0A8\uC790\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\uC751? \uC8C4\uC1A1\uD558\uC9C0\uB9CC \uC0AC\uC778\uC740 \uACF5\uC5F0\uC774
      \uB05D\uB098\uACE0\u2026"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\uC544, \uB2F9\uC2E0\uC774\uC5C8\uAD70\uC694. \uD14C\uC624\uB3C4\uB974
      \uBCA0\uC778\uC785\uB2C8\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\uC624\uB79C\uB9CC\uC774\uB124\uC694. \uB9CC\uB098 \uBD59\uAE38 \uACE0\uB300\uD558\uACE0
      \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uD14C\uC624\uB3C4\uB974 \uC528\uAD70\uC694."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 21300000, guid: 40bd066d7b2b57e4483a9d8476223c31, type: 3}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC800\uB294\u2026"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: 
    text: "\uBE48\uC13C\uD2B8 \uBCA0\uC778."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 1
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uBE48\uC13C\uD2B8 \uBCA0\uC778\uC785\uB2C8\uB2E4. \uACF5\uC5F0 \uD3EC\uC2A4\uD130\uC5D0\uC11C
      \uB2F9\uC2E0\uC758 \uC774\uB984\uC744 \uBD24\uC5B4\uC694."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 21300000, guid: 40bd066d7b2b57e4483a9d8476223c31, type: 3}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\uC544\uD558\uD558, \uAC10\uC0AC\uD569\uB2C8\uB2E4. \uC5D0\uBCA4\uC5D0\uC140
      \uBC15\uC0AC\uB97C \uAE30\uB9AC\uB294 \uC791\uD488\uC5D0 \uC624\uB974\uB2C8
      \uB2E4\uB4E4 \uBD80\uB7EC\uC6CC\uD558\uB354\uAD70\uC694."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 1
    rightPortrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\uD558\uC9C0\uB9CC \uC804\uBD80 \uBCA0\uC778 \uAC00\uC758 \uC774\uB984
      \uB355\uBD84\uC774\uC8E0. \uC774 \uACF5\uC5F0\uC740 \uB298 \uBCA0\uC778\uD640\uC5D0\uC11C
      \uC5F4\uB9AC\uB2C8\uAE4C\uC694."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\uC800\uB3C4 \uC774 \uC624\uB79C \uD611\uB825 \uAD00\uACC4\uB97C \uAC10\uC0AC\uD788
      \uC5EC\uAE30\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC5D8\uB9AC\uC5B4\uC2A4\uB77C\uB294 \uC0AC\uB78C\uC774 \uADF8\uB807\uAC8C
      \uAE50\uAE50\uD558\uB2E4\uBA74\uC11C\uC694?"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 21300000, guid: 40bd066d7b2b57e4483a9d8476223c31, type: 3}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uBC15\uC0AC \uC5ED\uC774 \uB204\uAC00 \uB420\uC9C0 \uB2E4\uB4E4 \uAD81\uAE08\uD574\uD558\uB358\uB370"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\u2026\uBC30\uC5ED\uC774 \uB298 \uBE44\uC5B4 \uC788\uB294 \uC774\uC720\uAC00
      \uAD81\uAE08\uD558\uC2E0 \uAC74\uAC00\uC694?"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 1
    rightPortrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\uAE00\uC384\uC694. \uBB54\uAC00 \uC774\uC720\uAC00 \uC788\uACA0\uC8E0."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\uC800\uB3C4 \uC5D8\uB9AC\uC5B4\uC2A4\uB97C \uC9C1\uC811 \uB9CC\uB098\uBCF8
      \uC801\uC740 \uC5C6\uC5B4\uC11C \uC790\uC138\uD55C \uAC74 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\uADF8\uB140\uB294 \uBC30\uC6B0\uB4E4 \uC55E\uC5D0\uB3C4 \uC27D\uAC8C
      \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0B4\uC9C0 \uC54A\uB294\uB2F5\uB2C8\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\uD558\uC9C0\uB9CC \uC804 \uB298 \uADF8\uB807\uB4EF \uCD5C\uC120\uC744
      \uB2E4\uD574 \uC5F0\uAE30\uD560 \uAC81\uB2C8\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\uC544, \uC2DC\uAC04\uC774\u2026 \uC900\uBE44\uD558\uB7EC \uAC00\uBD10\uC57C\uACA0\uB124\uC694."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC5D1\uC2A4\uD2B8\uB77C2"
    text: "\uACE7 \uBB34\uB300\uC5D0\uC11C \uBD59\uC8E0. \uC990\uAC70\uC6B4 \uAD00\uB78C
      \uB418\uC138\uC694."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
