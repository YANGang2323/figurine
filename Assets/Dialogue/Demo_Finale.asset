  lines:
  - speakerName: 
    text: "\uBB38\uC744 \uC5F4\uACE0 \uC5B4\uB450\uC6B4 \uCC3D\uACE0 \uC548\uC73C\uB85C
      \uB4E4\uC5B4\uAC14\uB2E4."
