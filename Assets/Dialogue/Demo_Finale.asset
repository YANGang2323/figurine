  - speakerName: 
    text: "\uB0A1\uC740 \uD0C1\uC790 \uC704\uC5D0\uB294 \uB450\uAEBC\uC6B4 \uC8FC\uC0AC\uAE30\uC640
      \uCC22\uC5B4\uC9C4 \uC5F0\uAD6C \uAE30\uB85D\uC774 \uB110\uB824 \uC788\uB2E4.
      \uAE30\uB85D\uC9C0\uB9C8\uB2E4 \uAC19\uC740 \uC5BC\uAD74\uC774 \uBC18\uBCF5\uD574\uC11C
      \uADF8\uB824\uC838 \uC788\uB2E4."
