    stopBGM: 0
    hasChoice: 0
    choices: []
  - speakerName: 
    text: "\uD1B5\uB85C\uAC00 \uB05D\uB098\uACE0. \uADF8\uACF3\uC5D0\uB294 \uAE68\uC9C4
      \uC720\uB9AC\uCC3D \uC0AC\uC774\uB85C \uB369\uAD74\uACFC \uBFCC\uB9AC\uAC00
      \uB4A4\uC5C9\uCF1C \uC788\uB2E4. \uBC29\uCE58\uB41C \uC5F0\uAD6C \uB3C4\uAD6C\uC640
      \uB179\uC2A8 \uBC30\uC591 \uC6A9\uAE30\uAC00 \uC2DD\uBB3C \uC0AC\uC774\uC5D0
      \uBC18\uCBE4 \uBB3B\uD600 \uC788\uC5C8\uB2E4."
    hideBackground: 0
    background: {fileID: 21300000, guid: eecc9c8bb16718b4984433526b9060a1, type: 3}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
