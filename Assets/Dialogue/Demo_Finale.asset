  - speakerName: 
    text: "\uADF8\uACF3\uC740 \uC644\uC804\uD55C \uC554\uC804\uC774\uC5C8\uB2E4.\n\uB4E4\uB9AC\uB294
      \uAC83\uC774\uB77C\uACE4 \uB0B4 \uBC1C\uAC78\uC74C \uC18C\uB9AC\uC640 \uC5B4\uB514\uC120\uAC00
      \uBB3C \uB5A8\uC5B4\uC9C0\uB294 \uC18C\uB9AC\uBFD0\uC774\uC5C8\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
