  - speakerName: 
    text: "\uCC3D\uACE0 \uD1B5\uB85C\uB97C \uC9C0\uB098\uC790 \uBA40\uB9AC\uC11C
      \uD76C\uBBF8\uD55C \uBE5B\uC774 \uC0C8\uC5B4 \uB4E4\uC5B4\uC654\uB2E4. \uB098\uB294
      \uADF8 \uAE38\uC744 \uB530\uB77C \uAC78\uC5C8\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 1
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    detailImage1: {fileID: 0}
    detailImage2: {fileID: 0}
