  - speakerName: "\uD14C\uC624\uB3C4\uB974 \uBCA0\uC778"
    text: "\uC804\uBD80 \uC124\uBA85\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB429\uB2C8\uB2E4.
      \uC800\uB294 \uB2F9\uC2E0\uC744 \uBBFF\uC73C\uB2C8\uAE4C\uC694."
