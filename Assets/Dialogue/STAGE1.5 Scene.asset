    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    soundEffect: {fileID: 0}
    soundVolume: 1
    hasChoice: 0
    choices: []
  - speakerName: 
    text: "\uBD89\uC740 \uB3CC\uC774 \uB4E0 \uC0C1\uC790\uB97C \uB192\uC774 \uB4E4\uC790
      \uAD00\uAC1D\uB4E4\uC774 \uC228\uC744 \uC0BC\uCF30\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 0
