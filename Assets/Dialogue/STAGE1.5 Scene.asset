    soundVolume: 1
    hasChoice: 0
    choices: []
  - speakerName: 
    text: "\uADF8\uB140\uC758 \uC628 \uAC00\uC871\uC740 \uADF8\uAC83\uC758 \uC815\uCCB4\uB97C
      \uC218\uC18C\uBB38\uD558\uAE30 \uC704\uD574 \uC804\uBB38\uAC00\uB4E4\uC744
      \uCC3E\uC544 \uB098\uC130\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 0
