  lines:
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "1\uC5F4 G..."
    hideBackground: 0
    background: {fileID: 21300000, guid: f4391888a1d100e46972c53f6075922d, type: 3}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
