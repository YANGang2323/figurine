    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC5B4\uB5A4 \uAD00\uAC1D\uB4E4\uC740 \uC5EC\uC804\uD788 \uBC15\uC218\uB97C
      \uCE58\uBA70 \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB0AC\uB294\uC9C0 \uD5F7\uAC08\uB824\uD558\uB294
      \uB4EF\uD588\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uBA3C\uC9C0\uAC00 \uC870\uAE08 \uAC00\uB77C\uC549\uC740 \uB4A4 \uBB34\uB300\uC5D0\uB294
      \uAD6C\uBA4D\uC774 \uB6AB\uB824 \uB4B7\uD3B8\uC774 \uB4DC\uB7EC\uB098\uC788\uC5C8\uB2E4."
    hideBackground: 0
