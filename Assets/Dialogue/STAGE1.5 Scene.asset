    soundVolume: 1
    hasChoice: 0
    choices: []
  - speakerName: 
    text: "\uB098\uB294 \uBB34\uB300\uCABD\uC5D0 \uAC00\uBC29\uC744 \uBD99\uC5EC\uB450\uACE4
