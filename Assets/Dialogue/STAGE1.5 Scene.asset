    soundVolume: 1
    hasChoice: 0
    choices: []
  - speakerName: 
    text: "\uC800\uB294 \uC624\uB798 \uC0B4\uC9C0 \uBABB\uD560 \uAC70\uC608\uC694.
      \uC774 \uC637\uC744 \uC785\uACE0 \uBB34\uB3C4\uD68C\uC5D0 \uAC04\uB2E4 \uD574\uB3C4
      \uC18C\uC6A9\uC5C6\uC5B4\uC694."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 1
    dialogueFont: {fileID: 11400000, guid: a3cc6a60fa3425943a59009135333441, type: 2}
    useCustomSpeakerFont: 0
    speakerFont: {fileID: 0}
    useCustomDialogueSize: 1
    dialogueFontSize: 50
    useCustomSpeakerSize: 0
    speakerFontSize: 0
    useCustomDialogueColor: 0
    dialogueColor: {r: 1, g: 1, b: 1, a: 1}
    useCustomSpeakerColor: 0
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    soundEffect: {fileID: 0}
    soundVolume: 1
    hasChoice: 0
    choices: []
  - speakerName: 
    text: "\uD074\uB77C\uB77C \uC544\uAC00\uC528\uB294 \uB2E8\uB150\uD55C \uBCF5\uC18C\uB9AC\uB85C
      \uC7AC\uB2E8\uC0AC\uC5D0\uAC8C \uB9D0\uD588\uB2E4. \uADF9 \uC911 \uADF8\uB140\uB294
      \uACE0\uCE60 \uC218 \uC5C6\uB294 \uC2EC\uC7A5\uBCD1\uC5D0 \uAC78\uB838\uB2E4,
      \uADF8\uB7F0 \uC124\uC815\uC774\uC5C8\uC9C0."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 0
    dialogueFont: {fileID: 0}
    useCustomSpeakerFont: 0
    speakerFont: {fileID: 0}
    useCustomDialogueSize: 0
    dialogueFontSize: 0
    useCustomSpeakerSize: 0
    speakerFontSize: 0
    useCustomDialogueColor: 0
    dialogueColor: {r: 1, g: 1, b: 1, a: 1}
    useCustomSpeakerColor: 0
    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    soundEffect: {fileID: 0}
    soundVolume: 1
    hasChoice: 0
    choices: []
  - speakerName: 
    text: "\uADF8\uB140\uB294 \uACE0\uAC1C\uB97C \uC800\uC5C8\uACE0, \uAC00\uC871\uB4E4\uC740
      \uC2AC\uD514\uC5D0 \uC7A0\uAE34 \uC5BC\uAD74\uC744 \uD588\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 0
    dialogueFont: {fileID: 0}
    useCustomSpeakerFont: 0
    speakerFont: {fileID: 0}
    useCustomDialogueSize: 0
    dialogueFontSize: 0
    useCustomSpeakerSize: 0
