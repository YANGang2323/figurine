    speakerColor: {r: 1, g: 1, b: 1, a: 1}
    soundEffect: {fileID: 0}
    soundVolume: 1
    hasChoice: 0
    choices: []
  - speakerName: 
    text: "\uC870\uC2EC\uC2A4\uB7FD\uAC8C \uD488\uC5D0\uC11C \uC0C1\uC790\uB97C \uAEBC\uB0B4
      \uAC74\uB124\uB294 \uC7AC\uB2E8\uC0AC."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
    useCustomDialogueFont: 0
    dialogueFont: {fileID: 0}
    useCustomSpeakerFont: 0
