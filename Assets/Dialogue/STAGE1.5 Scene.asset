    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC870\uBA85 \uC7A5\uCE58. \uB808\uC77C. \uB3C4\uB974\uB798."
