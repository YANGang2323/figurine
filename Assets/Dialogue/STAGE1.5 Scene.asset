  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uCC38, \uAC00\uBC29. \uC774\uAC78 \uB4E4\uACE0 \uC549\uAE30\uB294 \uC880\u2026"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uBB34\uB300 \uC606\uC5D0 \uC7A0\uAE50 \uB46C\uB3C4 \uB418\uACA0\uC9C0.
      \uC5B4\uCC28\uD53C \uBCA0\uC778 \uAC00 \uBB38\uC7A5\uC774 \uBD99\uC5B4 \uC788\uC73C\uB2C8\uAE4C."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: 
    text: "\uBD88\uC774 \uAEBC\uC84C\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 1
    rightPortrait: {fileID: 0}
  - speakerName: "\uAE30\uACC4"
    text: "\uACE7 \uACF5\uC5F0\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC9C0\uD718\uC790\uAC00 \uB4E4\uC5B4\uC628\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uBAA8\uB4E0 \uAD00\uAC1D\uC774 \uACF5\uC5F0\uB9CC\uC744 \uAE30\uB2E4\uB9AC\uB4EF
      \uAE30\uCE68 \uC18C\uB9AC \uD558\uB098 \uB0B4\uC9C0 \uC54A\uB294 \uC815\uC801."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uBB34\uAC70\uC6B4 \uC804\uC8FC \uC74C\uC545\uC774 \uD750\uB978\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "1\uB9C9."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: 
    text: "....\uC800\uB294 \uC624\uB798 \uC0B4\uC9C0 \uBABB\uD560 \uAC70\uC608\uC694.
      \uC774 \uC637\uC744 \uC785\uACE0 \uBB34\uB3C4\uD68C\uC5D0 \uAC04\uB2E4 \uD574\uB3C4
      \uC18C\uC6A9\uC5C6\uC5B4\uC694..."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC7AC\uB2E8\uC0AC\uC5D0\uAC8C \uACE0\uAC1C\uB97C \uAC00\uB85C\uC813\uB294
      \uD074\uB77C\uB77C \uC544\uAC00\uC528. \uACE0\uCE60 \uC218 \uC5C6\uB294 \uC2EC\uC7A5\uBCD1\uC5D0
      \uAC78\uB838\uB2E4, \uADF8\uB7F0 \uC124\uC815\uC774\uC5C8\uC9C0."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uADF8\uB140\uB294 \uACE0\uAC1C\uB97C \uC813\uACE0, \uAC00\uC871\uB4E4\uC740
      \uC2AC\uD514\uC5D0 \uC7A0\uAE34\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC870\uC2EC\uC2A4\uB7FD\uAC8C \uD488\uC5D0\uC11C \uC0C1\uC790\uB97C \uAEBC\uB0B4
      \uAC74\uB124\uB294 \uC7AC\uB2E8\uC0AC."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uC624\uB294 \uAE38\uC5D0 \uB9CC\uB09C \uC5B4\uB5A4 \uCCAD\uB144\uC774
      \uC544\uAC00\uC528\uC758 \uB531\uD55C \uC0AC\uC5F0\uC744 \uB4E3\uACE0 \uC774\uAC83\uC744
      \uAC74\uB124\uC8FC\uB354\uAD70\uC694."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uBD89\uC740 \uB3CC\uC774 \uB4E0 \uC0C1\uC790. \uAD00\uAC1D\uB4E4\uC774
      \uC228\uC744 \uC0BC\uCF30\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: 
    text: "\uADF8\uAC83\uC758 \uC815\uCCB4\uB97C \uC218\uC18C\uBB38\uD558\uAE30 \uC704\uD574
      \uADF8\uB140\uC758 \uC628 \uAC00\uC871\uC774 \uC804\uBB38\uAC00\uB4E4\uC744
      \uCC3E\uC544 \uB098\uC120\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: 
    text: "2\uB9C9. \uC544\uAE4C \uBCF8 \uB0A8\uC790\uAC00 \uBB34\uB300\uC5D0 \uC624\uB978\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: 
    text: "\uC790\uC2E0\uC744 \uB204\uAD70\uAC00\uC758 \uC870\uC218\uB77C\uACE0 \uC18C\uAC1C\uD55C
      \uB0A8\uC790\uB294 \uC8FC\uC778\uACF5\uC774 \uC704\uD5D8\uC5D0 \uCC98\uD558\uAC70\uB098
      \uC4F0\uB7EC\uC9C8 \uB54C\uB9C8\uB2E4 \uC57D\uC744 \uAC74\uB124\uACE0, \uAE38\uC744
      \uC54C\uB824\uC900\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: 
    text: "\uB9C9\uC774 \uB05D\uB0A0 \uB54C\uB9C8\uB2E4 \uAD00\uAC1D\uB4E4\uC774
      \uB3D9\uC2DC\uC5D0 \uBC15\uC218\uB97C \uCCE4\uB2E4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: 
    text: "2\uB9C9\uC774 \uB05D\uB098\uB358 \uADF8\uB54C."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uAE30\uACC4"
    text: "\uBE44\uC815\uC0C1 \uC2E0\uD638 \uAC10\uC9C0. \uC989\uC2DC \uCC98\uB9AC\uD558\uC2ED\uC2DC\uC624."
    hideBackground: 0
