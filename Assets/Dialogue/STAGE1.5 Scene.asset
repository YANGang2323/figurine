    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uAD00\uAC1D\uB4E4\uC740 \uADC0\uB97C \uB9C9\uACE0 \uBE44\uBA85\uC744
      \uC9C8\uB7EC\uB300\uBA70 \uD63C\uBE44\uBC31\uC0B0 \uD769\uC5B4\uC84C\uB2E4."
    hideBackground: 0
