  - speakerName: "\uBE48\uC13C\uD2B8 \uBCA0\uC778"
    text: "\uBB34\uB300 \uC606\uC5D0 \uC7A0\uAE50 \uB46C\uB3C4 \uB418\uACA0\uC9C0.
      \uC5B4\uCC28\uD53C \uC8FC\uCD5C \uCE21 \uAC00\uBC29\uC778\uAC78 \uC54C\uD14C\uB2C8."
    hideBackground: 0
