    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uBB34\uB300 \uC870\uBA85\uC774 \uC77C\uC81C\uD788 \uAEBC\uC9C0\uACE0
      \uC721\uC911\uD55C \uC640\uC774\uC5B4\uB4E4\uC774 \uBB34\uB300 \uC704\uB85C
      \uCD94\uB77D\uD588\uB2E4."
    hideBackground: 0
