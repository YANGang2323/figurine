%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d8d317eef674082489f00248ae6df60c, type: 3}
  m_Name: STAGE1 Scene1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: STAGE1 Scene1
  playOnlyOnce: 1
  lines:
  - speakerName: 
    text: "\uC5BC\uAD74 \uC704\uB85C \uC3DF\uC544\uC9C0\uB294 \uB208\uBD80\uC2E0
      \uBE5B."
    hideBackground: 0
    background: {fileID: 21300000, guid: 752b975b4ec4b814dad6b812c4264efc, type: 3}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: 
    text: "\uBD89\uC740 \uAC00\uBB38\uC758 \uBB38\uC7A5."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uC6B0\uB9AC \uAC00\uBB38\uC5D0 \uC628 \uAC78 \uD658\uC601\uD574, \uC544\uAC00."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uC800\uB7F0, \uADC0\uAC00 \uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uBAA8\uC591\uC774\uC5D0\uC694."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uBC15\uC0AC\uB2D8\uC5D0\uAC8C \uCC3E\uC544\uAC00 \uBCF4\uC790. \uADF8\uBD84\uC740
      \uBAA8\uB4E0 \uAC78 \uD574\uACB0\uD558\uC2DC\uAC70\uB4E0."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uADF8\uB798\uB3C4 \uB10C \uD6CC\uB96D\uD55C \uBCA0\uC778 \uAC00\uC758
      \uC77C\uC6D0\uC774\uC57C."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uBC15\uC0AC\uB2D8\uC774 \uB110 \uC704\uD574 \uAC10\uAC01 \uBCF4\uC870
      \uC7A5\uCE58\uB97C \uBC1C\uBA85\uD588\uC5B4!"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: 
    text: "\uC790\uAC00 \uC870\uC9C1 \uC7AC\uC0DD\uC220, \uC784\uC0C1 \uC131\uACF5."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uBCA0\uC778\uD640\uC774 \uC644\uACF5\uB418\uC5C8\uC2B5\uB2C8\uB2E4! "
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: 
    text: "\uC8FD\uC5B4\uAC00\uB358 \uC774\uB4E4\uC5D0\uAC8C \uB450 \uBC88\uC9F8
      \uC2EC\uC7A5\uC744."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uADF8\uBD84\uC740 \uC778\uB958\uC758 \uC704\uC778\uC774\uC57C!"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uADF8\uBD84\uC758 \uC5C5\uC801\uC744 \uAE30\uB9AC\uB294 \uACF5\uC5F0\uC774\uB798\uC694."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uC6B0\uB9B0 \uADF8\uC5D0\uAC8C \uAC10\uC0AC\uD574\uC57C \uD574."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uBC15\uC0AC\uB2D8 \uB300\uC5ED\uC774 \uC5C6\uB294\uB370?"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uADF8\uBD84\uC744 \uB300\uD45C\uD560 \uC218 \uC788\uB294 \uBC30\uC6B0\uAC00
      \uC5B4\uB514 \uC788\uC5B4?"
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: ???
    text: "\uADF8\uB798\uB3C4 \uADF8 \uACF5\uC5F0\uC740 \uC815\uB9D0 \uB300\uB2E8\uD588\uC5B4."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 0}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\u2026\uC5B8\uC81C \uC7A0\uC5D0 \uB4E4\uC5C8\uB354\uB77C?"
    hideBackground: 1
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 21300000, guid: c28917c0c77902645bfe12a8d1f76bc5, type: 3}
  - speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC774\uC81C \uADF8\uB9CC \uC77C\uC5B4\uB098\uC11C \uC8FC\uBCC0\uC744
      \uC0B4\uD3B4\uBCF4\uC790."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 0
    rightPortrait: {fileID: 21300000, guid: c28917c0c77902645bfe12a8d1f76bc5, type: 3}
  - speakerName: 
    text: "A, D \uD0A4\uB97C \uB20C\uB7EC \uC67C\uCABD, \uC624\uB978\uCABD\uC73C\uB85C
      \uC6C0\uC9C1\uC5EC \uBCF4\uC138\uC694."
    hideBackground: 0
    background: {fileID: 0}
    hideLeftPortrait: 0
    leftPortrait: {fileID: 0}
    hideRightPortrait: 1
    rightPortrait: {fileID: 0}
